<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Core" />
  </ItemGroup>

  <ItemGroup>    
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\stylecop.json" />
  </ItemGroup>

  <PropertyGroup>
      <Authors>Dave Woestenborghs and contributors</Authors>
      <Product>Umbraco.Community.PageNotFoundTracker</Product>
      <Company>Umbraco Community</Company>
      <PackageProjectUrl>https://github.com/dawoe/umbraco-page-not-found-tracker</PackageProjectUrl>
      <RepositoryUrl>https://github.com/dawoe/umbraco-page-not-found-tracker</RepositoryUrl>
      <PackageIconUrl />
      <PackageIcon>logo.png</PackageIcon>
      <PackageReadmeFile>readme.md</PackageReadmeFile>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <Description>Records requests that end in a 404 and lets editors turn tracked URLs into redirects or block them.</Description>
      <PackageTags>umbraco, umbraco-marketplace</PackageTags>
      <RepositoryType>git</RepositoryType>
      <Copyright>Copyright &#169; Dave Woestenborghs and contributors.</Copyright>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <AssemblyVersion>17.0.0</AssemblyVersion>
      <VersionPrefix>17.0.0</VersionPrefix>
      <InformationalVersion>17.0.0</InformationalVersion>
    </PropertyGroup>

  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
	
	<ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(AssemblyName).Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../assets/logo.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="../../assets/readme.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
