{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Umbraco.Cms.Tests": "Information"
    },
    "Console": {
      "DisableColors": true
    }
  },
  "Tests": {
    "Database": {
      "DatabaseType": "SQLite",
      "PrepareThreadCount": 2,
      "SchemaDatabaseCount": 2,
      "EmptyDatabasesCount": 1,
      "SQLServerMasterConnectionString": ""
    }
  },
  "Umbraco": {
    "Community": {
      "PageNotFoundTracker": {
        "NotFoundPageDocumentTypeAlias": "notFoundPage"
      }
    },
    "CMS": {
      "Content": {
        "AllowedUploadedFileExtensions": [ "jpg", "png", "gif", "svg" ]
      }
    }
  }
}
