<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Website_V17</RootNamespace>
    <IsPackable>false</IsPackable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="clean" Version="7.0.8" />
    <PackageReference Include="Umbraco.Cms" Version="17.8.0" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\code\Umbraco.Community.PageNotFoundTracker\Umbraco.Community.PageNotFoundTracker.csproj" />
    <!-- The entry project references the providers and BackOffice with PrivateAssets=all and never uses them in code,
         so a project-referencing site does not get their dlls (NuGet consumers get them from lib/). Without these
         references no tracking provider is registered (tracking is off) and the Management API controllers do not
         exist. -->
    <ProjectReference Include="..\..\src\code\Umbraco.Community.PageNotFoundTracker.Persistence.Sqlite\Umbraco.Community.PageNotFoundTracker.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\code\Umbraco.Community.PageNotFoundTracker.Persistence.SqlServer\Umbraco.Community.PageNotFoundTracker.Persistence.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\code\Umbraco.Community.PageNotFoundTracker.BackOffice\Umbraco.Community.PageNotFoundTracker.BackOffice.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
